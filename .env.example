# ---------------------------------------------------------------
# Keepsake — environment variables (copy to .env.local and fill in)
# Never commit real values. On Vercel set these in Project Settings → Environment Variables.
# ---------------------------------------------------------------

# Postgres (Neon). The pooled connection string works for both the app and migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign session cookies — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# First-run bootstrap: while the User table is empty, signing in with exactly
# these credentials creates the first ADMIN account.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Public sign-ups (default true). Set to false to close the /signup page.
SIGNUPS_ENABLED="true"
# Storage quota for new self-service accounts, in GB (default 5; 0 = unlimited).
DEFAULT_STORAGE_LIMIT_GB="5"

# Cloudflare R2 (S3-compatible object storage for chat text + media)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET="keepsake-media"
# Optional: override the S3 endpoint (e.g. a local MinIO/SeaweedFS for development).
# R2_ENDPOINT="http://127.0.0.1:9000"
