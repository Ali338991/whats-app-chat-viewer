// Keepsake — database schema (PostgreSQL / Neon).
// The client is generated into lib/generated/prisma (gitignored) by `prisma generate`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ChatStatus {
  UPLOADING
  READY
  FAILED
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique // always stored trimmed + lowercase
  passwordHash      String
  firstName         String
  lastName          String       @default("")
  role              Role         @default(USER)
  active            Boolean      @default(true)
  sessionVersion    Int          @default(0) // bump to revoke every session of this user
  storageLimitBytes BigInt? // null = unlimited
  failedLogins      Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  onboardedAt       DateTime?
  emailVerifiedAt   DateTime? // reserved for future email verification
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  chats             Chat[]
  auditEvents       AuditEvent[]
}

model Chat {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  status       ChatStatus  @default(UPLOADING)
  textKey      String
  me           String?
  messageCount Int
  firstDate    String?
  lastDate     String?
  preview      String?
  mediaCount   Int         @default(0)
  totalBytes   BigInt      @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime? // set when the user removes the chat (soft delete); data stays until an admin purges it
  media        MediaFile[]

  @@index([userId])
  @@index([deletedAt])
}

model MediaFile {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  name   String // original WhatsApp filename (basename)
  key    String // R2 object key
  size   BigInt
  mime   String
  kind   String // image | sticker | video | audio | file

  @@unique([chatId, name])
  @@index([chatId])
}

// Audit log: logins and in-chat activity (actor = userId), plus admin actions.
// Chat/media fields are snapshots with NO foreign keys, so entries survive deletes.
model AuditEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // LOGIN, SIGNUP, LOGOUT, LOGIN_FAILED, CHAT_OPEN, MEDIA_VIEW, VIDEO_PLAY, AUDIO_PLAY, DOC_DOWNLOAD, ADMIN_*
  chatId       String?
  chatName     String?
  mediaId      String?
  mediaName    String?
  mediaKind    String?
  targetUserId String?
  meta         Json?
  ip           String?
  userAgent    String?
  country      String?
  city         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([chatId])
  @@index([type])
}
